generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario          String   @id @default(uuid()) @db.Uuid
  cedula_usuario      String   @unique @db.VarChar(10)
  nombres_usuario     String   @db.VarChar(255)
  usuario             String   @unique @db.VarChar(50)
  email_usuario       String   @unique @db.VarChar(255)
  password_usuario    String   @db.VarChar(255)
  
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  tarjetas            Tarjeta[]
  cuentas             Cuenta[]
  movimientos         Movimiento[]

  @@map("usuarios")
}

model Cuenta {
  id_cuenta           String   @id @default(uuid()) @db.Uuid
  id_usuario          String   @db.Uuid
  tipo_cuenta         String   @db.VarChar(50) // 'Ahorros' | 'Corriente'
  numero_cuenta       String   @unique @db.VarChar(20)
  saldo_cuenta        Float    @default(0.0)
  
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  usuario             Usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("cuentas")
}

model Tarjeta {
  id_tarjeta          String   @id @default(uuid()) @db.Uuid
  id_usuario          String   @db.Uuid
  nombre_tarjeta      String   @db.VarChar(100)
  numero_tarjeta      String   @db.VarChar(20)
  saldo_tarjeta       Float    @default(0.0)
  
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  usuario             Usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("tarjetas")
}

model TipoMovimiento {
  id_tipo_movimiento  String       @id @default(uuid()) @db.Uuid
  codigo              String       @unique @db.VarChar(50) // 'transfer', 'purchase', 'subscription', 'deposit'
  nombre              String       @db.VarChar(100)        // 'Transferencia', 'Compra', 'Suscripción', 'Depósito'
  descripcion         String?      @db.VarChar(255)
  movimientos         Movimiento[]

  @@map("tipos_movimiento")
}

model Movimiento {
  id_movimiento       String          @id @default(uuid()) @db.Uuid
  id_usuario          String          @db.Uuid
  id_tipo_movimiento  String?         @db.Uuid
  nombre_movimiento   String          @db.VarChar(255)
  descripcion         String?         @db.VarChar(255)
  valor_movimiento    Float
  fecha_movimiento    DateTime        @default(now())
  
  fecha_creacion      DateTime        @default(now())
  fecha_actualizacion DateTime        @updatedAt

  usuario             Usuario         @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  tipo_movimiento     TipoMovimiento? @relation(fields: [id_tipo_movimiento], references: [id_tipo_movimiento])

  @@map("movimientos")
}

model Banco {
  id_banco               String                 @id @default(uuid()) @db.Uuid
  codigo_banco           String                 @unique @db.VarChar(50) // 'PTB', 'PICHINCHA', 'GUAYAQUIL', etc.
  nombre_banco           String                 @unique @db.VarChar(100)
  es_banco_local         Boolean                @default(false)
  
  fecha_creacion          DateTime               @default(now())
  fecha_actualizacion     DateTime               @updatedAt

  cuentas_interbancarias CuentaInterbancaria[]

  @@map("bancos")
}

model CuentaInterbancaria {
  id_cuenta_interbancaria String   @id @default(uuid()) @db.Uuid
  id_banco                String   @db.Uuid
  numero_cuenta           String   @unique @db.VarChar(20)
  tipo_cuenta             String   @db.VarChar(50) // 'Ahorros' | 'Corriente'
  titular_cuenta          String   @db.VarChar(255)
  cedula_titular          String   @db.VarChar(10)
  saldo_cuenta            Float    @default(0.0)
  activa                  Boolean  @default(true)
  
  fecha_creacion          DateTime @default(now())
  fecha_actualizacion     DateTime @updatedAt

  banco                   Banco    @relation(fields: [id_banco], references: [id_banco], onDelete: Cascade)

  @@map("cuentas_interbancarias")
}
